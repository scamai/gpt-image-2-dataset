# Twitter/X API v2 — required for scrape_gpt_image2.py and fetch_negatives.py
# Basic (paid) tier is required for the recent search endpoint with Bearer auth.
# https://developer.x.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=

# Google Gemini — required only if you run `curate_dataset.py --gemini-review`
# (optional vision pass over uncertain records)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — required for verify_openai.py and test_verifier.py
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
